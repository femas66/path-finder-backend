# Application Secret
JWT_SECRET=your_jwt_secret_key_here

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_NAME=path_finder_db

# Mail Server (SMTP) - Optional
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@pathfinder.com

# Firebase Cloud Messaging (FCM) - Optional (Defaults to SIMULATOR mode if empty)
FIREBASE_CREDENTIALS_FILE=
FIREBASE_CREDENTIALS_JSON=
FIREBASE_PROJECT_ID=
